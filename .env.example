# Chatshop environment variables.
#
# Two places hold configuration:
#   1. Next.js reads .env.local (copy the "Next.js" block below into it).
#   2. The Convex deployment has its own variables. Set each one in the
#      "Convex deployment" block with `npx convex env set NAME value`, or in
#      the Convex dashboard. They are NOT read from .env.local.
#
# Per-shop credentials (Shopify Storefront token, Meta page token) live in the
# `shops` table, not here.

# ---------------------------------------------------------------------------
# Next.js (.env.local)
# ---------------------------------------------------------------------------

# Written by `npx convex dev` on first run. Selects the dev deployment for the
# Convex CLI.
CONVEX_DEPLOYMENT=dev:your-deployment-name

# Convex client URL (https://<deployment>.convex.cloud).
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# Convex HTTP actions URL (https://<deployment>.convex.site). The Meta webhook
# routes in app/api/webhooks/* forward to `${CONVEX_SITE_URL}/webhooks/meta`.
# CONVEX_SITE_URL wins if both are set.
CONVEX_SITE_URL=https://your-deployment-name.convex.site
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment-name.convex.site

# ---------------------------------------------------------------------------
# Convex deployment (npx convex env set NAME value)
# ---------------------------------------------------------------------------

# Required. The deploy fails until these are set (declared in
# convex/convex.config.ts).
#   RESEND_API_KEY   Resend key for sign-up and password-reset emails.
#   SENDER_EMAIL     From address; must be on a domain verified in Resend.
#   SITE_URL         Where the Next.js app is served, e.g. https://app.example.com.
#                    Emailed links point here.
RESEND_API_KEY=re_xxxxxxxx
SENDER_EMAIL=auth@example.com
SITE_URL=http://localhost:3000

# Optional. Display name on auth emails (defaults to "Chatshop").
SENDER_NAME=Chatshop

# Optional. Comma-separated emails that may create an account. Existing shop
# members can always sign in. Unset = nobody new can sign up.
ALLOWED_SIGNUP_EMAILS=owner@example.com

# Meta webhooks (convex/webhooks.ts).
#   META_WEBHOOK_VERIFY_TOKEN  The "Verify token" entered in the Meta app's
#                              webhook settings.
#   META_APP_SECRET            Meta app secret; verifies X-Hub-Signature-256.
#   INSTAGRAM_APP_SECRET       Optional. Instagram app secret when it differs
#                              from META_APP_SECRET. Leave it unset otherwise:
#                              an empty value doesn't fall back to
#                              META_APP_SECRET, so Instagram webhooks fail.
META_WEBHOOK_VERIFY_TOKEN=choose-a-random-string
META_APP_SECRET=your-meta-app-secret
# INSTAGRAM_APP_SECRET=your-instagram-app-secret

# Model provider keys, read by the AI SDK. Only the provider picked in
# Settings is needed. The default model is Claude Opus 5.5 (Anthropic).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxx
# GOOGLE_GENERATIVE_AI_API_KEY=xxxxxxxx
